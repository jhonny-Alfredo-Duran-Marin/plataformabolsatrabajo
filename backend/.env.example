ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/egresa
JWT_SECRET=change-me-min-32-characters-please-openssl-rand
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_MINUTES=10080
CORS_ALLOWED_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200","http://localhost:8000","http://127.0.0.1:8000"]
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@egresa.uagrm.edu.bo
# Alternativa a SMTP por HTTPS (Railway bloquea SMTP en sus planes básicos). SMTP_FROM debe estar verificado en Brevo.
BREVO_API_KEY=

# Bitácora confidencial: clave pública de python -m scripts.clave_bitacora (vacía = sin cifrar).
BITACORA_CLAVE_PUBLICA=

# Tareas automáticas diarias: sin definir corren solo en el servidor (Railway).
# TAREAS_AUTOMATICAS_ACTIVAS=true
TAREAS_HORA_DIARIA=3
RESPALDOS_AUTOMATICOS_CONSERVAR=7

# Contraseña de las cuentas demo de scripts.sembrar_multitenant (pedila por el grupo; no se versiona)
DEMO_PASSWORD=

# Stripe (claves de prueba sk_test_/pk_test_ del dashboard de Stripe)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Opcional: secreto del endpoint /api/planes/stripe/webhook (whsec_...)
STRIPE_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:4200

# HU-23: en false las recomendaciones responden "no disponible" y el resto sigue andando (CP04)
IA_RECOMENDACIONES_ACTIVAS=true
# HU-28: en false el chatbot informa que el asistente no está disponible temporalmente (CP04)
IA_CHATBOT_ACTIVO=true
